{
    "core": "11.4.13",
    "password_service": "Drupal\\phpass\\Password\\PhpassHashedPassword",
    "checks": {
        "phpass_enabled": true,
        "legacy_password_accepted": true,
        "wrong_legacy_password_rejected": true,
        "legacy_hash_needs_rehash": true,
        "modern_password_accepted": true,
        "wrong_modern_password_rejected": true
    },
    "existing_accounts_modified": false,
    "limit": "Service fixture only; an owner must still test an existing account with its original password."
}
