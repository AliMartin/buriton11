--- old/src/Hook/SimilartermsHooks.php
+++ new/src/Hook/SimilartermsHooks.php
@@ -0,0 +1,125 @@
+<?php
+
+namespace Drupal\similarterms\Hook;
+
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Routing\RouteMatchInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+
+/**
+ * Hook implementations for similarterms.
+ */
+class SimilartermsHooks {
+  use StringTranslationTrait;
+
+  /**
+   * Constructs a new SimilartermsHooks object.
+   *
+   * @param \Drupal\Core\Extension\ModuleHandlerInterface $moduleHandler
+   *   The module handler service.
+   * @param \Drupal\Core\Entity\EntityTypeManagerInterface $entityTypeManager
+   *   The entity type manager service.
+   */
+  public function __construct(
+    protected ModuleHandlerInterface $moduleHandler,
+    protected EntityTypeManagerInterface $entityTypeManager,
+  ) {
+  }
+
+  /**
+   * Implements hook_help().
+   *
+   * {@inheritdoc}
+   */
+  #[Hook('help')]
+  public function help($route_name, RouteMatchInterface $route_match) {
+    switch ($route_name) {
+      case 'help.page.similarterms':
+        $output = '';
+        $output .= '<h3>' . $this->t('About') . '</h3>';
+        $output .= '<p>' . $this->t('Similar by Terms module provides context for content items by displaying a block of other similar content.') . '</p>';
+        $output .= '<p>' . $this->t('Similarity is based on the taxonomy terms assigned to content.') . '</p>';
+        return $output;
+
+      default:
+    }
+  }
+
+  /**
+   * Implements hook_views_data_alter().
+   *
+   * {@inheritdoc}
+   */
+  #[Hook('views_data_alter')]
+  public function viewsDataAlter(&$data): void {
+    if ($this->moduleHandler->moduleExists('taxonomy_entity_index')) {
+      // When taxonomy_entity_index is enabled, its index covers term references
+      // on any entity type, so expose the handlers for all content entity
+      // types.
+      $entity_types = $this->entityTypeManager->getDefinitions();
+      foreach ($entity_types as $entity_type) {
+        $base_table = $entity_type->getBaseTable();
+        if ($entity_type->getGroup() != 'content' || empty($base_table) || !$entity_type->getKey('id')) {
+          continue;
+        }
+        $data[$base_table]['similarterms'] = [
+          'group' => $this->t('Similar by terms'),
+          'title' => $this->t('Similarity'),
+          'help' => $this->t('Percentage/count of terms which @type has in common with @type given as argument.', [
+            '@type' => $entity_type->getLabel(),
+          ]),
+          'field' => [
+            'id' => 'similar_terms_field',
+          ],
+          'sort' => [
+            'id' => 'similar_terms_sort',
+          ],
+        ];
+        $data[$base_table]['similar_' . $entity_type->getKey('id')] = [
+          'title' => $this->t('@type ID', [
+            '@type' => $entity_type->getLabel(),
+          ]),
+          'group' => $this->t('Similar by terms'),
+          'help' => $this->t('ID of @type item(s).', [
+            '@type' => $entity_type->getLabel(),
+          ]),
+          'argument' => [
+            'id' => 'similar_terms_arg',
+            'name field' => 'title',
+            'numeric' => TRUE,
+            'validate type' => $entity_type->getKey('id'),
+          ],
+        ];
+      }
+    }
+    else {
+      // Without taxonomy_entity_index only nodes are indexed (core
+      // taxonomy_index).
+      $data['node']['similarterms'] = [
+        'group' => $this->t('Similar by terms'),
+        'title' => $this->t('Similarity'),
+        'help' => $this->t('Percentage/count of terms which node has in common with node given as argument.'),
+        'field' => [
+          'id' => 'similar_terms_field',
+        ],
+        'sort' => [
+          'id' => 'similar_terms_sort',
+        ],
+      ];
+      $data['node']['similar_nid'] = [
+        'title' => $this->t('Nid'),
+        'group' => $this->t('Similar by terms'),
+        'help' => $this->t('ID of content item(s).'),
+        'argument' => [
+          'id' => 'similar_terms_arg',
+          'name field' => 'title',
+          'numeric' => TRUE,
+          'validate type' => 'nid',
+        ],
+      ];
+    }
+  }
+
+}
