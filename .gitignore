# Drupal legacy-project layout: composer.json and the web root are here.
# Keep Composer manifests/locks, patches, custom code, sync exports and docs.
# Keep root scaffold files (especially .htaccess) visible for review/versioning.

# Site credentials and local environment overrides.
/sites/*/*settings*.php
!/sites/default/default.settings.php
!/sites/default/settings.local.php
/sites/*/*services*.yml
!/sites/default/default.services.yml
/sites/*/drushrc.php
/sites/development.services.yml
/.env
/.env.*
!/.env.example
!/.env.dist
/.aws/

# Uploaded content, private storage, database backups and temporary files.
/sites/*/files/
/sites/*/public/
/sites/*/private/
/sites/*/files-public/
/sites/*/files-private/
/sites/*/translations/
/sites/*/tmp/
/sites/*/cache/
/private-files/
/database/
/tmp/
/.ddev/upgrade-study-archive/
/.ddev/db_snapshots/
/.ddev/.env
/.ddev/.env.*
*.sql
*.sql.gz

# Composer-managed code and browser libraries; rebuild from the locked manifest.
/vendor/
/core/
/modules/contrib/
/profiles/contrib/
/themes/contrib/
# Patched upstream packages installed here by Composer; patches/locks are source.
/modules/custom/tb_megamenu/
/themes/custom/bootstrap5/
/libraries/

# Downloaded tooling and frontend build dependencies at any depth.
node_modules/
bower_components/
.sass-cache/
/composer.phar
/composer
/robo.phar
/robo
/drush.phar
/drush
/drupal.phar
/drupal

# Workstation/editor state and FTP connection settings.
.DS_Store
/.vscode/
ftpsync.settings
*.swp
*.swo
/autoload.php

# DDEV generates routes and local TLS material for current and copied projects.
/.ddev/traefik/

# Immutable local upgrade reference builds (contain settings and backups).
/_upgrade-poc/
# Local DDEV generated project state.
/.ddev/
